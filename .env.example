# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy this file to .env and adjust variables as needed for your local environment.
# Sensitive keys, credentials, and passwords have been stripped.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application & Laravel Settings
# ------------------------------------------------------------------------------
APP_NAME="CV Laboratory"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# ------------------------------------------------------------------------------
# Database Settings (Credentials blanked)
# ------------------------------------------------------------------------------
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=cv_laboratory
# DB_USERNAME=root
# DB_PASSWORD=

# ------------------------------------------------------------------------------
# Session, Cache, & Queue Drivers
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# ------------------------------------------------------------------------------
# React / Vite Frontend Configuration
# ------------------------------------------------------------------------------
VITE_APP_VERSION=v4.0.0
GENERATE_SOURCEMAP=false
VITE_APP_BASE_NAME=/
VITE_API_URL=http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# FastAPI Backend Configuration
# ------------------------------------------------------------------------------
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
